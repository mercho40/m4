{
  "name": "@repo/back",
  "private": true,
  "type": "module",
  "imports": {
    "#back/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "bun build --compile --minify --sourcemap --bytecode --target bun --outfile server src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "start": "NODE_ENV=production ./server",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "elysia": "^1.4.30"
  },
  "devDependencies": {
    "bun-types": "^1.4.2",
    "drizzle-kit": "^0.31.11",
    "pg": "^8.23.1",
    "typescript": "~6.0.3"
  }
}
