{
  "name": "@repo/back",
  "private": true,
  "type": "module",
  "imports": {
    "#back/*": "./src/*",
    "#test/*": "./test/*"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "bun build --compile --minify --sourcemap --bytecode --target bun --outfile server src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "start": "NODE_ENV=production ./server",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "bun test --no-env-file --parallel=4 --no-isolate"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "catalog:",
    "@elysiajs/cors": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "elysia": "catalog:"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "bun-types": "catalog:",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "pg": "catalog:",
    "typescript": "catalog:"
  }
}
