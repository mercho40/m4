# What `bun run test` (Vitest, mode "test") builds the env modules with, over a
# developer's own .env: tests never depend on a local setup or reach a real
# API. Not secrets; never use these anywhere else.
PUBLIC_API_URL=http://api.example.test
PUBLIC_SITE_URL=http://app.example.test
BETTER_AUTH_SECRET=test-only-secret-not-used-outside-the-unit-tests
