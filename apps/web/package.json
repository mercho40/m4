    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@typescript/native": "npm:typescript@7",
    "bits-ui": "^2.19.4",
    "clsx": "^2.1.1",
    "elysia": "^1.4.30",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.2"
