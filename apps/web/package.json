{
  "name": "@repo/web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "bun --bun run vite dev --port 3001",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --watch",
    "check-types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
