{
  "name": "@repo/web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "bun --bun run vite dev --port 3001",
    "build": "vite build",
    "preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
    "prepare": "svelte-kit sync || echo ''",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --watch",
    "check-types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@lucide/svelte": "catalog:",
    "@repo/eslint-config": "workspace:*",
    "@sveltejs/adapter-cloudflare": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@typescript/native": "catalog:",
    "bits-ui": "catalog:",
    "clsx": "catalog:",
    "elysia": "catalog:",
    "eslint": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "tailwind-variants": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "dependencies": {
    "@elysiajs/eden": "catalog:",
    "@repo/back": "workspace:*",
    "better-auth": "catalog:"
  }
}
