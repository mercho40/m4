.env
.env.local
.env.development.local
.env.test.local
.env.production.local

**/**/.env

# Testing
coverage

# Turbo
.turbo

# Wrangler's local state, and its local secrets file if anyone makes one
.wrangler/
.dev.vars*

# Build Outputs
build
dist
# The compiled Elysia binary, anchored. A bare `**/**/server` also matched
# SvelteKit's conventional `src/lib/server/` directory, silently excluding
# server-only modules that tracked routes import.
/apps/back/server
/apps/back/server.map
# svelte-check --tsgo writes its Svelte-to-TS output here where a package has
# no .svelte-kit
.svelte-check


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

# Agents
# Shared agent instructions and tooling ARE tracked so every harness — and every
# teammate — gets them: AGENTS.md (canonical), .agents/skills/ (with
# .claude/skills symlinked to it), and .mcp.json.
# Only per-user state stays ignored:
.claude/settings.local.json
skills-lock.json

# Local tooling artifacts
apps/web/.playwright-cli/
*.swp

# Playwright (e2e/): reports, traces and the servers' logs
playwright-report/
test-results/
e2e/.logs/

# Rendered from haloy.preview.yaml by the preview workflows
apps/back/haloy.pr.yaml
