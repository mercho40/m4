# Build context is the repo root (see apps/back/Dockerfile). Keep it small and,
# more importantly, keep secrets out of the image.

# Secrets — these must never enter the build context, where they would sit in
# the build stage's layers. (Bun auto-loads .env from the working directory but
# only fills variables that are unset, so a stray copy would quietly supply
# values Haloy did not inject.)
**/.env
**/.env.*
!**/.env.example

# Installed and generated
node_modules
**/node_modules
apps/web/.svelte-kit
apps/web/build
apps/web/.wrangler
apps/back/server
apps/back/server.map
.turbo
**/.turbo

# Frontend — deployed to Cloudflare Workers, not part of this image
apps/web/src
apps/web/static
apps/web/vite.config.ts
apps/web/components.json
apps/web/wrangler.jsonc

# Tests, lint and local tooling: the image needs only the workspaces'
# package.json files (the Dockerfile copies those), never their contents.
apps/back/test
apps/back/**/*.test.ts
apps/back/eslint.config.js
apps/back/bunfig.toml
e2e/*
!e2e/package.json
packages/eslint-config/*
!packages/eslint-config/package.json
scripts
t3.json
docker-compose.yml

# Version control and local tooling
.git
.github
.gitignore
apps/web/.playwright-cli

# Agent tooling and docs — no effect on the binary
.agents
.claude
.mcp.json
AGENTS.md
README.md
docs
