# Production's build-time values for the web app (its PUBLIC_* variables that
# reach `vite build`), read by CI's Test job and by the Deploy job, so a pull
# request builds the web app exactly as main deploys it. Changing a line here
# redeploys the web app (deploy.yml watches this file). One NAME=value per
# line, no quotes: it is appended to $GITHUB_ENV as is.
#
# The values below are the template's placeholders. Replace them with your
# own before the first deploy: the Deploy job refuses to ship example.com.

# The API's origin: apps/back/haloy.yaml's domain. Static, so it is inlined
# into the bundle.
PUBLIC_API_URL=https://api.example.com
# The web app's canonical origin, baked into the prerendered robots.txt,
# sitemap.xml and llms.txt and the social sign-in callback URLs. Must be
# WEB_URL in apps/back/haloy.yaml, and an absolute URL.
PUBLIC_SITE_URL=https://app.example.com
